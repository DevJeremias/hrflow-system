{
  "name": "hrflow-system",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/run-workspace.mjs frontend build",
    "lint": "node scripts/run-workspace.mjs frontend lint",
    "typecheck": "node scripts/run-workspace.mjs frontend typecheck",
    "verify": "node scripts/verify.mjs",
    "test": "node scripts/run-workspace.mjs backend test && node scripts/run-workspace.mjs frontend test",
    "db:create": "node scripts/db.mjs create",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:status": "node scripts/db.mjs status",
    "db:audit": "node scripts/db.mjs audit",
    "db:seed": "node scripts/db.mjs seed",
    "db:setup": "node scripts/db.mjs setup",
    "db:reset": "node scripts/db.mjs reset"
  }
}
