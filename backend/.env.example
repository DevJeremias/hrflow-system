# Servidor
PORT=3000

# Conexão com o MySQL (DB_PORT só precisa mudar se o servidor não usa a 3306)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=hrflow_db

# Autenticação JWT (obrigatório, mínimo de 32 bytes): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Proxy reverso: número de proxies confiáveis à frente da API (ex.: 1) ou sub-redes (ex.: loopback).
# Vazio significa nenhum proxy confiável: X-Forwarded-For é ignorado e o limitador de tentativas
# de login e cadastro usa o IP do socket. Atrás de um proxy sem esta variável, todos os clientes
# dividem o mesmo limite; "true" é recusado porque permitiria forjar o cabeçalho.
# O mesmo valor faz a API enxergar o HTTPS do proxy (X-Forwarded-Proto) e marcar os cookies de sessão
# como Secure. Em produção defina também NODE_ENV=production: assim os cookies são Secure em qualquer
# host que não seja localhost, mesmo que o proxy não informe o HTTPS.
TRUST_PROXY=
