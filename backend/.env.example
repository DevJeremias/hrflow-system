# Servidor
PORT=3000

# Conexão com o MySQL
DB_HOST=
DB_USER=
DB_PASS=
DB_NAME=hrflow_db

# Autenticação JWT
JWT_SECRET=

# Proxy reverso: número de proxies confiáveis à frente da API (ex.: 1) ou sub-redes (ex.: loopback).
# Vazio significa nenhum proxy confiável: X-Forwarded-For é ignorado e o limitador de tentativas
# de login e cadastro usa o IP do socket. Atrás de um proxy sem esta variável, todos os clientes
# dividem o mesmo limite; "true" é recusado porque permitiria forjar o cabeçalho.
TRUST_PROXY=
