[Unit]
Description=Deploy por pull do HRFlow (publica a main quando o CI passa)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=ec2-user
ExecStart=/opt/hrflow/deploy/auto-deploy.sh
# O build das imagens na t4g.micro e uma migração lenta cabem; passar disso é travamento.
TimeoutStartSec=30min
