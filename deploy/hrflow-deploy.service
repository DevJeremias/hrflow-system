[Unit]
Description=Deploy por pull do HRFlow (publica a main quando o CI passa)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=ec2-user
ExecStart=/opt/hrflow/deploy/auto-deploy.sh
# Imagem grande e migração lenta cabem; passar disso é travamento.
TimeoutStartSec=20min
