# Copie para /opt/hrflow/deploy/.env (modo 600, dono ec2-user) e preencha. O arquivo real NUNCA vai para o git.
# Gerar segredo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Banco (o MySQL só aceita conexão da rede interna do compose)
MYSQL_ROOT_PASSWORD=
DB_NAME=hrflow_db
DB_USER=hrflow_app
DB_PASS=

# Assinatura das sessões (mínimo de 32 bytes). Trocar derruba todas as sessões (runbook, "Rotacionar segredos").
JWT_SECRET=

# Endereço do alias <ip>.sslip.io (redireciona para PUBLIC_HOSTNAME) e nome definitivo.
SITE_ADDRESS=
PUBLIC_HOSTNAME=hrflow.calliari.dev

# Só se a máquina precisar carregar fixtures de homologação com seed.sh.
# HRFLOW_SEED_PASSWORD=
